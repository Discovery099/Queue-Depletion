// =====================================================================================
// STRAT-02 : Queue-Depletion Momentum with Liquidity Regime Filter
// TradingView Pine Script v5 — strategy for backtesting on ES (E-mini S&P 500) 5-min RTH
// -------------------------------------------------------------------------------------
// Faithful port of the Python reference engine. Use on an ES/MES 5-minute chart.
// Set the chart's Regular Trading Hours and timezone to "America/New_York".
//
// Notes / unavoidable platform differences vs. the Python engine:
//  * ta.stdev uses population stdev; the Python realized-vol uses sample variance.
//    This produces a tiny difference in f_toxicity but does not change the logic.
//  * Rolling 200-bar quantiles use ta.percentile_linear_interpolation (close match).
//  * TradingView fills stop/limit exits intrabar; time/EOD/regime exits act on bar
//    close. Stop has natural intrabar priority, matching the spec's exit ordering.
//  * Costs: $2.50 / contract / side commission + 1 tick slippage / side  (= $30 RT).
// =====================================================================================

//@version=5
strategy("STRAT-02 Queue-Depletion Momentum",
     overlay=true,
     pyramiding=0,
     initial_capital=100000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=2.5,
     slippage=1,
     process_orders_on_close=true,
     calc_on_every_tick=false)

// ------------------------------------------------------------------ INPUTS (8 params)
dep_threshold          = input.float(0.15,   "Min |depletion MA5| (P1)",        step=0.01)
tox_threshold          = input.float(0.20,   "Min |toxicity MA5| (P2)",         step=0.01)
momentum_confirm       = input.float(0.0002, "Min |momentum_3| Tight-Deep (P3)",step=0.0001)
breakthrough_threshold = input.float(0.10,   "Min |depletion diff| Wide-Thin (P4)", step=0.01)
exit_bars              = input.int(4,         "Max holding bars (P5)",           minval=1)
profit_target_pct      = input.float(0.8,    "Profit target x ATR (P6)",        step=0.1)
stop_loss_pct          = input.float(0.6,    "Stop loss x ATR (P7)",            step=0.1)
min_volume_pctile      = input.float(30.0,   "Min volume percentile (P8)",      step=5.0)
invert_signal          = input.bool(false,   "Invert signal direction (diagnostic)")
use_rth_only           = input.bool(true,    "Trade Regular Trading Hours only")

// ------------------------------------------------------------------ SESSION / TIME
rth          = time(timeframe.period, "0930-1600", "America/New_York")
in_rth       = not na(rth)
tradable     = use_rth_only ? in_rth : true
sess_start   = in_rth and not in_rth[1]

var int bar_in_day = 0
if sess_start
    bar_in_day := 0
else if in_rth
    bar_in_day := bar_in_day + 1

// ------------------------------------------------------------------ RAW PRICE FEATURES
prev_close = close[1]
lr         = math.log(close / prev_close)
tr         = math.max(high - low, math.max(math.abs(high - prev_close), math.abs(low - prev_close)))
tr        := na(prev_close) ? (high - low) : tr
bar_range  = (high - low) / close

// BVC ratio (close position within the bar)
bvc_ratio  = (high > low) ? (close - low) / (high - low) : 0.5

// ATR (simple moving average of TR, NOT Wilder)
atr20      = ta.sma(tr, 20)
atr_pct    = atr20 / close

// Realized volatility (annualized) — population stdev approximation
vol_real20 = ta.stdev(lr, 20) * math.sqrt(252 * 78)

// Volume features
vol_sma20  = ta.sma(volume, 20)
vol_ratio  = vol_sma20 > 0 ? volume / vol_sma20 : 1.0

// ------------------------------------------------------------------ DEPLETION
bvc_signed   = 2 * bvc_ratio - 1
range_exp    = atr_pct > 0 ? math.min(bar_range / atr_pct, 10.0) : 1.0
vol_ind      = volume > vol_sma20 ? 1.0 : 0.0
depletion    = bvc_signed * range_exp * vol_ind
dep_abs      = math.abs(depletion)
dep_ma5      = ta.sma(depletion, 5)
dep_ma10     = ta.sma(depletion, 10)
dep_diff     = dep_ma5 - dep_ma10

// ------------------------------------------------------------------ TOXICITY
denom        = math.max(na(vol_real20) ? 0.1 : vol_real20, 0.001)
tox_raw      = math.max(math.min(depletion * dep_abs / denom, 100.0), -100.0)
tox_ma5      = ta.sma(tox_raw, 5)

// ------------------------------------------------------------------ TREND / MOMENTUM
ema12        = ta.ema(close, 12)
ema26        = ta.ema(close, 26)
ema_diff     = (ema12 - ema26) / close
mom3         = (close - close[3]) / close[3]
mom6         = (close - close[6]) / close[6]

// ------------------------------------------------------------------ LIQUIDITY REGIME
rel_vol      = math.max(vol_sma20 > 0 ? volume / vol_sma20 : 1.0, 0.1)
liq_score    = bar_range * math.pow(rel_vol, -0.5)
q33          = ta.percentile_linear_interpolation(liq_score, 200, 33)
q66          = ta.percentile_linear_interpolation(liq_score, 200, 66)
regime       = na(q33) or na(q66) ? 1 : (liq_score < q33 ? 0 : (liq_score < q66 ? 1 : 2))

// ------------------------------------------------------------------ POSITION SIZE
dep_abs_sma  = ta.sma(dep_abs, 100)
pos_scale    = dep_abs_sma > 0 ? math.max(math.min(dep_abs / dep_abs_sma, 2.0), 0.1) : 1.0
qty          = math.max(1, math.min(2, math.round(pos_scale)))

// ------------------------------------------------------------------ VOLUME PERCENTILE GUARD
vlo          = ta.lowest(volume, 100)
vhi          = ta.highest(volume, 100)
vpct         = (volume - vlo) / (vhi - vlo + 1e-10)

// ------------------------------------------------------------------ ENTRY GUARDS
guards_ok = tradable
     and bar_in_day >= 1 and bar_in_day <= 74
     and atr20 >= 1.0
     and regime != 2
     and math.abs(dep_ma5) >= dep_threshold
     and math.abs(tox_ma5) >= tox_threshold
     and vpct >= min_volume_pctile / 100.0
     and not na(dep_ma5) and not na(tox_ma5) and not na(mom3)

// ------------------------------------------------------------------ DIRECTION (regime logic)
dir = 0
if guards_ok
    if regime == 0  // Tight-Deep: continuation
        if dep_ma5 > 0 and mom3 > momentum_confirm and ema_diff > 0
            dir := 1
        else if dep_ma5 < 0 and mom3 < -momentum_confirm and ema_diff < 0
            dir := -1
    else if regime == 1  // Wide-Thin: breakthrough
        if dep_diff > breakthrough_threshold and bar_range > atr_pct * 1.2 and vol_ratio > 1.5
            dir := 1
        else if dep_diff < -breakthrough_threshold and bar_range > atr_pct * 1.2 and vol_ratio > 1.5
            dir := -1
if invert_signal and dir != 0
    dir := -dir

// ------------------------------------------------------------------ STATE FOR EXITS
var float entry_atr = na
var int   entry_bar = na

// ------------------------------------------------------------------ ENTRIES (only when flat)
if strategy.position_size == 0 and dir != 0
    entry_atr := atr20
    entry_bar := bar_index
    if dir == 1
        strategy.entry("L", strategy.long, qty=qty)
    else
        strategy.entry("S", strategy.short, qty=qty)

// ------------------------------------------------------------------ EXITS
if strategy.position_size != 0
    pa      = strategy.position_avg_price
    isLong  = strategy.position_size > 0
    sd      = stop_loss_pct  * entry_atr
    pd      = profit_target_pct * entry_atr
    stopP   = isLong ? pa - sd : pa + sd
    limP    = isLong ? pa + pd : pa - pd
    strategy.exit("X", stop=stopP, limit=limP)
    // Time / end-of-day / regime-change exits (bar close)
    held    = bar_index - entry_bar
    if held >= exit_bars or bar_in_day >= 76 or regime == 2
        strategy.close_all(comment="time/eod/regime")

// ------------------------------------------------------------------ PLOTS
plotchar(regime == 0, "Tight-Deep", "·", location.bottom, color.new(color.teal, 0), size=size.tiny)
plotchar(regime == 1, "Wide-Thin",  "·", location.bottom, color.new(color.orange, 0), size=size.tiny)
plotchar(regime == 2, "Disrupted",  "·", location.bottom, color.new(color.red, 0), size=size.tiny)
bgcolor(regime == 2 ? color.new(color.red, 92) : na, title="Disrupted shade")
